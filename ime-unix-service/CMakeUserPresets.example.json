{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-vcpkg",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "macos-vcpkg",
      "inherits": "macos",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-vcpkg",
      "configurePreset": "linux-vcpkg",
      "configuration": "Release"
    },
    {
      "name": "macos-vcpkg",
      "configurePreset": "macos-vcpkg",
      "configuration": "Release"
    }
  ]
}
