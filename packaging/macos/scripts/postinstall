#!/bin/sh
set -eu

APP="/Library/Input Methods/LlavonIME.app"
PAYLOAD="/Library/Application Support/llavon-ime"
TIS_TOOL="${PAYLOAD}/tools/llavon-ime-tis"

console_user="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [ -z "${console_user}" ] || [ "${console_user}" = "root" ] || [ "${console_user}" = "loginwindow" ]; then
    console_user="${SUDO_USER:-}"
fi

if [ -n "${console_user}" ] && id "${console_user}" >/dev/null 2>&1; then
    uid="$(id -u "${console_user}")"

    # Stop the running input method so the replaced bundle is picked up.
    /usr/bin/pkill -x -u "${uid}" LlavonIME >/dev/null 2>&1 || true

    # Best effort: ask the text input system to pick up the new source in the
    # console user's session. macOS still requires the user to select and
    # approve the input source in System Settings on first use.
    if [ -x "${TIS_TOOL}" ]; then
        /bin/launchctl asuser "${uid}" "${TIS_TOOL}" register "${APP}" >/dev/null 2>&1 || true
    fi

    echo "llavon-ime: add 「拉風輸入法」 in System Settings > Keyboard > Input Sources."
    echo "llavon-ime: the first install may require a log out and back in."
else
    echo "llavon-ime: no active user found; add 「拉風輸入法」 in System Settings > Keyboard > Input Sources."
fi

/bin/chmod -R a+rX "${PAYLOAD}" 2>/dev/null || true

exit 0
