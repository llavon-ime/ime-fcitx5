#!/bin/sh
set -eu

APP="/Library/Input Methods/LlavonIME.app"
PAYLOAD="/Library/Application Support/llavon-ime"
TIS_TOOL="${PAYLOAD}/tools/llavon-ime-tis"

console_user="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [ -z "${console_user}" ] || [ "${console_user}" = "root" ] || [ "${console_user}" = "loginwindow" ]; then
    console_user="${SUDO_USER:-}"
fi

if [ -n "${console_user}" ] && id "${console_user}" >/dev/null 2>&1; then
    uid="$(id -u "${console_user}")"
    as_user() {
        /bin/launchctl asuser "${uid}" /usr/bin/sudo -u "${console_user}" "$@"
    }

    bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
        "${APP}/Contents/Info.plist" 2>/dev/null || true)"
    bundle_id="${bundle_id:-com.llavon.inputmethod.LlavonIME}"

    # Stop the running input method so the replaced bundle is picked up, and
    # wait for it to exit: `open` would otherwise activate the dying process
    # instead of launching the new bundle.
    /usr/bin/pkill -x -u "${uid}" LlavonIME >/dev/null 2>&1 || true
    for _ in 1 2 3 4 5; do
        if ! /usr/bin/pgrep -x -u "${uid}" LlavonIME >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done

    # Launch the input method once before touching the input source: a
    # replaced bundle leaves the text input system pointing at the old one,
    # and the app's own registration is what makes the new bundle current.
    # Launching it here also makes the input method usable without logging
    # out.
    if as_user /usr/bin/open "${APP}" 2>/dev/null; then
        for _ in 1 2 3 4 5; do
            /usr/bin/pgrep -x -u "${uid}" LlavonIME >/dev/null 2>&1 && break
            sleep 1
        done
    else
        echo "llavon-ime: could not launch 「拉風輸入法」 now; switch to it once and macOS will start it." >&2
    fi

    # Replacing the bundle makes the text input system drop the enabled input
    # source, which is what leaves the input menu without 「拉風輸入法」 after an
    # install. Register the new bundle and, where the OS allows it, enable the
    # source again. TISEnableInputSource is a no-op for third-party input
    # methods, so `enable` writes the enabled-sources preference directly on
    # macOS 15 and earlier; the source then shows up at the next login, when
    # the input menu is rebuilt from it. macOS 26 keeps the enabled
    # third-party sources in a protected store that only System Settings
    # writes, so there the source has to be added there once. An upgrade
    # keeps the state it already has and needs nothing.
    if [ -x "${TIS_TOOL}" ]; then
        as_user "${TIS_TOOL}" register "${APP}" || true

        enable_output=""
        for _ in 1 2 3; do
            enable_output="$(as_user "${TIS_TOOL}" enable "${bundle_id}" 2>&1 || true)"
            case "${enable_output}" in
                *enabled=1*|*deferred*) break ;;
            esac
            sleep 1
        done
        case "${enable_output}" in
            *enabled=1*|*deferred*) ;;
            *) echo "llavon-ime: could not enable 「拉風輸入法」 (${enable_output}); add it under System Settings > Keyboard > Input Sources." >&2 ;;
        esac
    fi

    # TextInputSwitcher caches input source icons in memory and ignores
    # SIGTERM, so a stale instance keeps showing an icon-less switcher HUD.
    # CursorUIViewService is left alone: killing it takes the caret UI down
    # with it.
    /usr/bin/killall -9 -u "${console_user}" TextInputSwitcher >/dev/null 2>&1 || true

    echo "llavon-ime: 「拉風輸入法」 is installed."
    echo "llavon-ime: if it is not in the input menu, add it under System Settings > Keyboard > Input Sources."
else
    echo "llavon-ime: no active user found; add 「拉風輸入法」 in System Settings > Keyboard > Input Sources."
fi

# The Windows bundle downloads the optional LoRA Trainer during installation;
# mirror that here so the model-improvement flow works out of the box. A
# failure is non-fatal: the settings page can install or update it later.
LORA_MANAGER="${PAYLOAD}/payload/bin/llavon-ime-lora"
LORA_DIR="${PAYLOAD}/tools/lora"
if [ -x "${LORA_MANAGER}" ] && [ ! -x "${LORA_DIR}/llavon-lora" ]; then
    echo "llavon-ime: downloading the pinned LoRA Trainer release..."
    if ! "${LORA_MANAGER}" install-trainer --output-dir "${LORA_DIR}"; then
        echo "llavon-ime: LoRA Trainer download failed; install it later from the input method settings."
    fi
fi

/bin/chmod -R a+rX "${PAYLOAD}" 2>/dev/null || true

exit 0
