<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Passed to pkgbuild with --component-plist. BundleIsRelocatable=false keeps
  Installer from "upgrading" a copy of the app that lives somewhere else (for
  example ~/Library/Input Methods/LlavonIME.app): without it, an existing
  copy in the home directory makes the package install there instead of
  /Library/Input Methods, which leaves two bundles with the same identifier
  and no way for the uninstaller to find the one that shadows the other.
-->
<array>
	<dict>
		<key>BundleHasStrictIdentifier</key>
		<true/>
		<key>BundleIsRelocatable</key>
		<false/>
		<key>BundleIsVersionChecked</key>
		<true/>
		<key>BundleOverwriteAction</key>
		<string>upgrade</string>
		<key>RootRelativeBundlePath</key>
		<string>Library/Input Methods/LlavonIME.app</string>
	</dict>
</array>
</plist>
